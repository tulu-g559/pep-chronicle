     "authors": ["Brandt Bucher", "Daniel F Moisset", "Tobias Kohn", "Ivan Levkivskyi", "Guido van Rossum", "Talin"]},

    {"id": "pep_634", "type": "Proposal", "pep_number": 634, "title": "Structural Pattern Matching: Specification",
     "status": "Final", "replaces": "pep_622", "python_version": "3.10", "created": "2020-09-12",
     "authors": ["Brandt Bucher", "Guido van Rossum"]},

    {"id": "pep_635", "type": "Proposal", "pep_number": 635, "title": "Structural Pattern Matching: Motivation and Rationale",
     "status": "Final", "python_version": "3.10", "created": "2020-09-12",
     "authors": ["Tobias Kohn", "Talin"]},

    {"id": "pep_636", "type": "Proposal", "pep_number": 636, "title": "Structural Pattern Matching: Tutorial",
